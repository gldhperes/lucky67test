  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  sequenceSpeed: 1.8
  crawlPanel: {fileID: 1991080373}
  crawlContent: {fileID: 435722239}
  crawlText: {fileID: 435722240}
  crawlDuration: 20
  crawlStartPosition: {x: 0, y: -267}
  crawlEndPosition: {x: 0, y: 215}
  openingCrawl: 'Before the collapse, humanity believed that the number 67 was a
    symbol of luck, power, and prosperity.


    Today, little remains of the humanity
    we once knew.


    Unknown creatures have taken over the world, and military
    forces are on the verge of extinction.


    In one final attempt at survival,
    a prototype weapon capable of containing these threats was developed.


    Dozens
    of volunteers participated in the tests. None of them were successful.


    Now,
    only one final attempt remains.


    TEST No. 67.'
  dialoguePanel: {fileID: 211338026}
  dialogueText: {fileID: 626699194}
  letterDelay: 0.035
  dialogueLines: []
  skipPanel: {fileID: 1919617966}
